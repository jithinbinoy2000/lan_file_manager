{
  "name": "studio-files",
  "version": "1.0.0",
  "description": "A local-first file manager for your own machine",
  "scripts": {
    "dev": "concurrently -k -n server,web \"tsx watch apps/server/src/index.ts --port 3210\" \"vite\"",
    "build": "tsc -p apps/server/tsconfig.json && vite build",
    "prestart": "node scripts/check-build.mjs",
    "start": "node dist/server/apps/server/src/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test apps/server/test/*.test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@fontsource/roboto": "5.3.0",
    "@use-gesture/react": "10.3.1",
    "archiver": "8.0.0",
    "busboy": "1.6.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "express": "5.2.1",
    "lucide-react": "1.47.0",
    "mime-types": "3.0.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-zoom-pan-pinch": "4.2.0",
    "screenfull": "6.0.2",
    "sharp": "0.35.4",
    "sonner": "2.0.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/archiver": "8.0.0",
    "@types/busboy": "1.5.4",
    "@types/express": "5.0.6",
    "@types/mime-types": "3.0.1",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "10.0.5",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  },
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  }
}
